# Copier ce fichier vers .env.local puis renseigner les valeurs de la console Firebase.
# Ces variables sont publiques par conception (préfixe NEXT_PUBLIC_) : la sécurité
# est assurée par les règles Firestore, pas par la confidentialité de ces clés.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-studio-android-suivicm2-d0fbd686.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-studio-android-suivicm2-d0fbd686
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ai-studio-android-suivicm2-d0fbd686.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# ID de base de données Firestore (Named database) utilisé par l'application Android.
NEXT_PUBLIC_FIREBASE_DATABASE_ID=ai-studio-android-suivicm2-d0fbd686-7c39-42f8-97e3-108c900c1d0f
